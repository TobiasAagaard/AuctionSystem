<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Auction.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Auction.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Auction.Avalonia">

    <!-- The ViewLocator (see App.axaml) turns whatever view model is in CurrentPage
         into its matching view, so swapping CurrentPage swaps the page shown here. -->
    <Panel>
        <!-- Main content fills the window. -->
        <ContentControl Content="{Binding CurrentPage}" />

        <!-- Keep the notification list last so it renders above the page. -->
        <ItemsControl ItemsSource="{Binding Notifications.Notifications}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="16"
                      MaxWidth="360">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToastViewModel">
                    <Border Background="#E61E1E2E"
                            CornerRadius="10"
                            Padding="16,14"
                            Margin="0,0,0,10"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="1"
                            BoxShadow="0 4 16 0 #40000000">
                        <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    Background="{Binding AccentBrush}"
                                    CornerRadius="2" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Message}"
                                       TextWrapping="Wrap"
                                       Foreground="#F1F1F1"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Content="×"
                                    FontSize="16"
                                    Background="Transparent"
                                    Foreground="#9CA3AF"
                                    Padding="4,0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Notifications.DismissCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>
    </Panel>

    
</Window>
