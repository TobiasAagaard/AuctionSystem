<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="Auction.Avalonia.Views.BusView">
  <StackPanel Width="250" HorizontalAlignment="Left" Margin="0, 0, 0, 0">

    <DockPanel HorizontalAlignment="Stretch" HorizontalSpacing="20" Margin="0, 0, 0, 0">
      <TextBlock Width="100" HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="Height"/>
      <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
    </DockPanel>
    
    <DockPanel HorizontalAlignment="Stretch" HorizontalSpacing="20" Margin="0, 5, 0, 0">
      <TextBlock Width="100" HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="Length"/>
      <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
    </DockPanel>

    <DockPanel HorizontalAlignment="Stretch" HorizontalSpacing="20" Margin="0, 5, 0, 0">
      <TextBlock Width="100" HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="Weight"/>
      <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
    </DockPanel>

    <DockPanel HorizontalAlignment="Stretch" HorizontalSpacing="20" Margin="0, 5, 0, 0">
      <TextBlock Width="100" HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="Seat count"/>
      <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
    </DockPanel>

    <DockPanel HorizontalAlignment="Stretch" HorizontalSpacing="20" Margin="0, 5, 0, 0">
      <TextBlock Width="100" HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="Bed count"/>
      <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
    </DockPanel>

    <DockPanel HorizontalAlignment="Stretch" HorizontalSpacing="20" Margin="0, 5, 0, 0">
      <TextBlock Width="100" HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="Toilet"/>
      <CheckBox/>
    </DockPanel>
    
  </StackPanel>
</UserControl>