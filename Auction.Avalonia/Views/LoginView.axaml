<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Auction.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Auction.Avalonia.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Design.DataContext>
        <vm:LoginViewModel />
    </Design.DataContext>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">

        <TextBlock
            Text="Login"
            VerticalAlignment="Center"
            Padding="0 0 0 20"
            FontSize="30"
            FontWeight="300"/>

        <TextBox PlaceholderText="Username" Text="{Binding Username}" Width="250" Margin="0 0 0 20"/>

        <TextBox PlaceholderText="Password" Text="{Binding Password}" Width="250" PasswordChar="*" />

        <StackPanel Orientation="Horizontal" Margin="5 10 0 0" Spacing="30">
            <TextBlock Text="Not registered?" />
            <TextBlock
                Text="Create user" 
                Foreground="Blue"
                TextDecorations="Underline"
                Cursor="Hand"
                PointerPressed="OnCreateUserPressed"/>

        </StackPanel>
        
        <Button
            Content="Login"
            Background="#5db85d"
            Foreground="#eee"
            Width="100"
            Margin="0 10 0 0"
            HorizontalContentAlignment="Center"
            HorizontalAlignment="Right"
            Cursor="Hand"
            />
    </StackPanel>

</UserControl>
