<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Auction.Avalonia.Views.HomeWindow"
        Title="HomeWindow">
    <DockPanel>
      <Border DockPanel.Dock="Right" Padding="20">
        <StackPanel Spacing="5">
          <Button Content="+ Set for sale" Padding="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FF33B733" Foreground="White"></Button>
          <Button Content="User profile" Padding="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#eee" BorderBrush="#555"></Button>
          <Button Content="Bid history" Padding="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#eee" BorderBrush="#555"></Button>
        </StackPanel>
      </Border>
      <ScrollViewer>

      <StackPanel>
        
        <TextBlock Text="Your auctions" FontSize="24" Margin="20"/>
        
        <Border Padding="40 0">
          <Border BorderBrush="#ccc" BorderThickness="1" HorizontalAlignment="Stretch">
            <Grid Background="White">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Grid.Row="1" Background="#eee" BorderBrush="#ccc" BorderThickness="1">
                <TextBlock Text="Name" FontSize="14" Margin="10" FontWeight="Bold" HorizontalAlignment="Center"/>
              </Border>
              <Border Grid.Column="1" Grid.Row="1" Background="#eee" BorderBrush="#ccc" BorderThickness="1">
                <TextBlock Text="Årgang" FontSize="14" Margin="10" FontWeight="Bold" HorizontalAlignment="Center"/>
              </Border>
              <Border Grid.Column="2" Grid.Row="1" Background="#eee" BorderBrush="#ccc" BorderThickness="1">
                <TextBlock Text="Bud" FontSize="14" Margin="10" FontWeight="Bold" HorizontalAlignment="Center"/>
              </Border>
            </Grid>
          </Border>
        </Border>


        <TextBlock Text="Current auctions" FontSize="24" Margin="20"/>
      
        <Border Padding="40 0">
          <Border BorderBrush="#ccc" BorderThickness="1" HorizontalAlignment="Stretch">
            <Grid Background="White">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Grid.Row="1" Background="#eee" BorderBrush="#ccc" BorderThickness="1">
                <TextBlock Text="Name" FontSize="14" Margin="10" FontWeight="Bold" HorizontalAlignment="Center"/>
              </Border>
              <Border Grid.Column="1" Grid.Row="1" Background="#eee" BorderBrush="#ccc" BorderThickness="1">
                <TextBlock Text="Årgang" FontSize="14" Margin="10" FontWeight="Bold" HorizontalAlignment="Center"/>
              </Border>
              <Border Grid.Column="2" Grid.Row="1" Background="#eee" BorderBrush="#ccc" BorderThickness="1">
                <TextBlock Text="Bud" FontSize="14" Margin="10" FontWeight="Bold" HorizontalAlignment="Center"/>
              </Border>
            </Grid>
          </Border>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
